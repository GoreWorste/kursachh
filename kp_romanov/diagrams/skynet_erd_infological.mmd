%%{init: {'theme': 'dark'}}%%
erDiagram
    РОЛЬ {
        int код_роли PK
        varchar наименование_роли
    }

    ПОЛЬЗОВАТЕЛЬ {
        int код_пользователя PK
        varchar логин
        varchar email
        varchar фио
        datetime дата_регистрации
    }

    СТАТУС {
        int код_статуса PK
        varchar наименование_статуса
    }

    КАТЕГОРИЯ {
        int код_категории PK
        varchar наименование_категории
    }

    ЗАЯВКА {
        int номер_заявки PK
        varchar тема
        text описание
        varchar приоритет
        datetime дата_создания
        datetime дата_обновления
        boolean признак_удаления
    }

    КОММЕНТАРИЙ {
        int номер_комментария PK
        text текст_комментария
        datetime дата_создания
    }

    ВЛОЖЕНИЕ {
        int номер_вложения PK
        varchar имя_файла
        int размер_файла
        datetime дата_загрузки
    }

    ЛОГ {
        int номер_записи PK
        varchar прежний_статус
        varchar новый_статус
        datetime дата_изменения
    }

    СТАТЬЯ_БАЗЫ_ЗНАНИЙ {
        int номер_статьи PK
        varchar заголовок
        text содержание
        datetime дата_создания
        datetime дата_обновления
    }

    УВЕДОМЛЕНИЕ {
        int номер_уведомления PK
        varchar тип_уведомления
        boolean прочитано
        datetime дата_отправки
    }

    ПОПЫТКА_ВХОДА {
        int номер_попытки PK
        varchar логин
        boolean успешно
        varchar ip_адрес
        datetime дата_попытки
    }

    ТОКЕН_СБРОСА_ПАРОЛЯ {
        int номер_токена PK
        varchar хэш_токена
        datetime срок_действия
        boolean использован
        datetime дата_создания
    }

    РОЛЬ ||--o{ ПОЛЬЗОВАТЕЛЬ : имеет
    ПОЛЬЗОВАТЕЛЬ ||--o{ ЗАЯВКА : создает
    ПОЛЬЗОВАТЕЛЬ ||--o{ ЗАЯВКА : назначается
    СТАТУС ||--o{ ЗАЯВКА : определяет
    КАТЕГОРИЯ ||--o{ ЗАЯВКА : относится_к
    ЗАЯВКА ||--o{ КОММЕНТАРИЙ : содержит
    ПОЛЬЗОВАТЕЛЬ ||--o{ КОММЕНТАРИЙ : пишет
    ЗАЯВКА ||--o{ ВЛОЖЕНИЕ : имеет
    ЗАЯВКА ||--o{ ЛОГ : история_статусов
    ПОЛЬЗОВАТЕЛЬ ||--o{ ЛОГ : изменяет
    ПОЛЬЗОВАТЕЛЬ ||--o{ СТАТЬЯ_БАЗЫ_ЗНАНИЙ : автор
    ПОЛЬЗОВАТЕЛЬ ||--o{ УВЕДОМЛЕНИЕ : получает
    ЗАЯВКА ||--o{ УВЕДОМЛЕНИЕ : формирует
    ПОЛЬЗОВАТЕЛЬ ||--o{ ПОПЫТКА_ВХОДА : выполняет
    ПОЛЬЗОВАТЕЛЬ ||--o{ ТОКЕН_СБРОСА_ПАРОЛЯ : запрашивает
